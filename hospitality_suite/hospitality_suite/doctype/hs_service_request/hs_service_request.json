 "naming_rule": "Expression (old style)",
 "fields": [
  {
   "fieldname": "company",
   "label": "Compañía",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "property",
   "label": "Establecimiento",
   "fieldtype": "Link",
   "options": "HS Property",
   "reqd": 1
  },
  {
   "fieldname": "stay",
   "label": "Estancia",
   "fieldtype": "Link",
   "options": "HS Stay"
  },
  {
   "fieldname": "folio",
   "label": "Cuenta de estancia",
   "fieldtype": "Link",
   "options": "HS Folio"
  },
  {
   "fieldname": "customer",
   "label": "Cliente pagador",
   "fieldtype": "Data"
  },
  {
   "fieldname": "item",
   "label": "Artículo",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "warehouse",
   "label": "Almacén",
   "fieldtype": "Link",
   "options": "HS Warehouse"
  },
  {
   "fieldname": "quantity",
   "label": "Cantidad",
   "fieldtype": "Float",
   "default": 1
  },
  {
   "fieldname": "included",
   "label": "Incluido sin recargo",
   "fieldtype": "Check"
  },
  {
   "fieldname": "currency",
   "label": "Moneda",
   "fieldtype": "Link",
   "options": "Currency",
   "reqd": 1
  },
  {
   "fieldname": "amount",
   "label": "Importe",
   "fieldtype": "Currency",
   "default": 0,
   "options": "currency",
   "reqd": 1
  },
  {
   "fieldname": "status",
   "label": "Estado",
   "fieldtype": "Select",
   "options": "Requested\nIn Progress\nDelivered\nCancelled\nReturned",
   "reqd": 1,
   "default": "Requested"
  },
  {
   "fieldname": "charge",
   "label": "Cargo",
   "fieldtype": "Link",
   "options": "HS Charge"
  },
  {
   "fieldname": "stock_entry",
   "label": "Movimiento de inventario",
   "fieldtype": "Data"
  },
  {
   "fieldname": "return_stock_entry",
   "label": "Devolución de inventario",
   "fieldtype": "Data"
  },
  {
   "fieldname": "opening_stock_issue",
   "label": "Salida histórica de inventario",
   "fieldtype": "Code",
   "options": "JSON",
   "hidden": 1,
   "print_hide": 1
  },
  {
   "fieldname": "credit_note",
   "label": "Nota de crédito",
   "fieldtype": "Data"
  },
  {
   "fieldname": "sales_invoice",
   "label": "Factura de venta",
   "fieldtype": "Data"
  },
  {
   "fieldname": "pms_receivable",
   "label": "Cuenta por cobrar PMS",
   "fieldtype": "Link",
   "options": "HS PMS Receivable"
  },
  {
   "fieldname": "notes",
   "label": "Observaciones",
   "fieldtype": "Small Text"
  }
 ],
