{
 "doctype": "DocType",
 "name": "HS Portal Request",
 "module": "Hospitality Suite",
 "custom": 0,
 "engine": "InnoDB",
 "track_changes": 1,
 "autoname": "SOL-.YYYY.-.#####",
 "naming_rule": "Expression (old style)",
 "fields": [
  {
   "fieldname": "company",
   "label": "Compañía",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "property",
   "label": "Establecimiento",
   "fieldtype": "Link",
   "options": "HS Property",
   "reqd": 1
  },
  {
   "fieldname": "full_name",
   "label": "Nombre completo",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "email",
   "label": "Correo electrónico",
   "fieldtype": "Data",
   "options": "Email"
  },
  {
   "fieldname": "phone",
   "label": "Teléfono",
   "fieldtype": "Data"
  },
  {
   "fieldname": "starts_at",
   "label": "Desde",
   "fieldtype": "Datetime",
   "reqd": 1
  },
  {
   "fieldname": "ends_at",
   "label": "Hasta",
   "fieldtype": "Datetime",
   "reqd": 1
  },
  {
   "fieldname": "category",
   "label": "Categoría",
   "fieldtype": "Link",
   "options": "HS Category",
   "reqd": 1
  },
  {
   "fieldname": "rooms",
   "label": "Habitaciones",
   "fieldtype": "Int",
   "default": 1
  },
  {
   "fieldname": "people",
   "label": "Personas",
   "fieldtype": "Int",
   "default": 1
  },
  {
   "fieldname": "mode",
   "label": "Modalidad",
   "fieldtype": "Select",
   "options": "Hotel\nPor tiempo\nDay Pass",
   "reqd": 1,
   "default": "Hotel"
  },
  {
   "fieldname": "status",
   "label": "Estado",
   "fieldtype": "Select",
   "options": "Hold\nRequested\nConverted\nExpired\nCancelled\nRejected",
   "reqd": 1,
   "default": "Hold"
  },
  {
   "fieldname": "hold_until",
   "label": "Retención hasta",
   "fieldtype": "Datetime"
  },
  {
   "fieldname": "request_until",
   "label": "Solicitud hasta",
   "fieldtype": "Datetime"
  },
  {
   "fieldname": "currency",
   "label": "Moneda",
   "fieldtype": "Link",
   "options": "Currency",
   "reqd": 1
  },
  {
   "fieldname": "amount",
   "label": "Importe",
   "fieldtype": "Currency",
   "default": 0,
   "options": "currency",
   "reqd": 1
  },
  {
   "fieldname": "quote_snapshot",
   "label": "Cotización aceptada",
   "fieldtype": "Code",
   "options": "JSON"
  },
  {
   "fieldname": "experiences",
   "label": "Experiencias",
   "fieldtype": "Code",
   "options": "JSON"
  },
  {
   "fieldname": "request_key",
   "label": "Referencia de solicitud",
   "fieldtype": "Data",
   "unique": 1,
   "hidden": 1
  },
  {
   "fieldname": "payload_hash",
   "label": "Huella de solicitud",
   "fieldtype": "Data",
   "hidden": 1
  },
  {
   "fieldname": "booking",
   "label": "Reserva",
   "fieldtype": "Link",
   "options": "HS Booking"
  }
 ],
 "field_order": [
