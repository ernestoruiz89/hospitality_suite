{
 "doctype": "DocType",
 "name": "HS Room Block",
 "module": "Hospitality Suite",
 "custom": 0,
 "engine": "InnoDB",
 "track_changes": 1,
 "autoname": "BLO-.YYYY.-.#####",
 "naming_rule": "Expression (old style)",
 "fields": [
  {
   "fieldname": "company",
   "label": "Compañía",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "property",
   "label": "Establecimiento",
   "fieldtype": "Link",
   "options": "HS Property",
   "reqd": 1
  },
  {
   "fieldname": "room",
   "label": "Habitación",
   "fieldtype": "Link",
   "options": "HS Room",
   "reqd": 1
  },
  {
   "fieldname": "reason",
   "label": "Motivo",
   "fieldtype": "Select",
   "options": "House Use\nVIP Hold\nOwner\nMaintenance\nOther",
   "reqd": 1,
   "default": "House Use"
  },
  {
   "fieldname": "starts_at",
   "label": "Desde",
   "fieldtype": "Datetime",
   "reqd": 1
  },
  {
   "fieldname": "ends_at",
   "label": "Hasta",
   "fieldtype": "Datetime",
   "reqd": 1
  },
  {
   "fieldname": "status",
   "label": "Estado",
   "fieldtype": "Select",
   "options": "Active\nReleased",
   "reqd": 1,
   "default": "Active"
  },
  {
   "fieldname": "note",
   "label": "Nota",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "created_by",
   "label": "Registrado por",
   "fieldtype": "Link",
   "options": "User"
  },
  {
   "fieldname": "released_by",
   "label": "Liberado por",
   "fieldtype": "Link",
   "options": "User"
  },
  {
   "fieldname": "released_on",
   "label": "Liberado el",
   "fieldtype": "Datetime"
  },
  {
   "fieldname": "release_note",
   "label": "Motivo de liberación",
   "fieldtype": "Small Text"
  }
 ],
 "field_order": [
  "company",
  "property",
  "room",
  "reason",
  "starts_at",
  "ends_at",
  "status",
  "note",
  "created_by",
  "released_by",
  "released_on",
  "release_note"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "HS Administrator",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "HS Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "HS Supervisor",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "HS Receptionist",
   "read": 1,
   "report": 1,
   "export": 0,
   "print": 1,
   "create": 1,
   "write": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "allow_rename": 0
}
