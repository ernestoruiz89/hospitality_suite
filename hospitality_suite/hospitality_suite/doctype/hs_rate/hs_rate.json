{
 "doctype": "DocType",
 "name": "HS Rate",
 "module": "Hospitality Suite",
 "custom": 0,
 "engine": "InnoDB",
 "track_changes": 1,
 "autoname": "TAR-.#####",
 "naming_rule": "Expression (old style)",
 "fields": [
  {
   "fieldname": "company",
   "label": "Compañía",
   "fieldtype": "Link",
   "options": "Company",
   "reqd": 1
  },
  {
   "fieldname": "property",
   "label": "Establecimiento",
   "fieldtype": "Link",
   "options": "HS Property",
   "reqd": 1
  },
  {
   "fieldname": "title",
   "label": "Título",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "category",
   "label": "Categoría",
   "fieldtype": "Link",
   "options": "HS Category",
   "reqd": 1
  },
  {
   "fieldname": "mode",
   "label": "Modalidad",
   "fieldtype": "Select",
   "options": "Hotel\nMotel",
   "reqd": 1,
   "default": "Hotel"
  },
  {
   "fieldname": "currency",
   "label": "Moneda",
   "fieldtype": "Link",
   "options": "Currency",
   "reqd": 1
  },
  {
   "fieldname": "amount",
   "label": "Importe",
   "fieldtype": "Currency",
   "default": 0,
   "options": "currency",
   "reqd": 1
  },
  {
   "fieldname": "block_hours",
   "label": "Horas del bloque",
   "fieldtype": "Float",
   "default": 3
  },
  {
   "fieldname": "extra_hour_rate",
   "label": "Precio de hora adicional",
   "fieldtype": "Currency",
   "default": 0,
   "options": "currency"
  },
  {
   "fieldname": "grace_minutes",
   "label": "Tolerancia (minutos)",
   "fieldtype": "Int",
   "default": 0
  },
  {
   "fieldname": "rounding_minutes",
   "label": "Fracción de cobro (minutos)",
   "fieldtype": "Int",
   "default": 60
  },
  {
   "fieldname": "additional_person_rate",
   "label": "Precio por persona adicional",
   "fieldtype": "Currency",
   "default": 0,
   "options": "currency"
  },
  {
   "fieldname": "included_people",
   "label": "Personas incluidas",
   "fieldtype": "Int",
   "default": 2
  },
  {
   "fieldname": "extra_bed_rate",
   "label": "Precio por cama adicional",
   "fieldtype": "Currency",
   "default": 0,
   "options": "currency"
  },
  {
   "fieldname": "priority",
   "label": "Prioridad",
   "fieldtype": "Int",
   "default": 10
  },
  {
   "fieldname": "valid_from",
   "label": "Vigente desde",
   "fieldtype": "Date"
  },
  {
   "fieldname": "valid_to",
   "label": "Vigente hasta",
   "fieldtype": "Date"
  },
  {
   "fieldname": "weekdays",
   "label": "Días de la semana",
   "fieldtype": "Data",
   "description": "0=lunes ... 6=domingo; vacío=todos"
  },
  {
   "fieldname": "customer",
   "label": "Cliente pagador",
   "fieldtype": "Link",
   "options": "Customer"
  },
  {
   "fieldname": "night_start",
   "label": "Inicio de paquete nocturno",
   "fieldtype": "Time"
  },
  {
   "fieldname": "night_end",
   "label": "Fin de paquete nocturno",
   "fieldtype": "Time"
  },
  {
   "fieldname": "included_services",
   "label": "Servicios incluidos",
   "fieldtype": "Table",
   "options": "HS Rate Service"
  },
  {
   "fieldname": "active",
   "label": "Habilitado",
   "fieldtype": "Check",
   "default": 1
  },
  {
   "fieldname": "change_reason",
   "label": "Motivo del cambio de tarifa",
   "fieldtype": "Small Text",
   "depends_on": "eval:!doc.__islocal"
  }
 ],
 "field_order": [
  "company",
  "property",
  "title",
  "category",
  "mode",
  "currency",
  "amount",
  "block_hours",
  "extra_hour_rate",
  "grace_minutes",
  "rounding_minutes",
  "additional_person_rate",
  "included_people",
  "extra_bed_rate",
  "priority",
  "valid_from",
  "valid_to",
  "weekdays",
  "customer",
  "night_start",
  "night_end",
  "included_services",
  "active",
  "change_reason"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "HS Administrator",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "HS Manager",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "HS Supervisor",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "HS Receptionist",
   "read": 1,
   "report": 1,
   "export": 0,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "HS Cashier",
   "read": 1,
   "report": 1,
   "export": 0,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "HS Accountant",
   "read": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "create": 1,
   "write": 1
  },
  {
   "role": "HS Auditor",
   "read": 1,
   "report": 1,
   "export": 0,
   "print": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "allow_rename": 0,
 "title_field": "title",
 "search_fields": "title",
 "show_title_field_in_link": 1
}
