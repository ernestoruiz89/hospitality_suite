{
 "doctype": "DocType",
 "name": "HS Incident",
 "module": "Hospitality Suite",
 "custom": 0,
 "engine": "InnoDB",
 "track_changes": 1,
 "autoname": "INC-.YYYY.-.#####",
 "naming_rule": "Expression (old style)",
 "fields": [
  {
   "fieldname": "company",
   "label": "Compañía",
   "fieldtype": "Data",
   "reqd": 1
  },
  {
   "fieldname": "property",
   "label": "Establecimiento",
   "fieldtype": "Link",
   "options": "HS Property",
   "reqd": 1
  },
  {
   "fieldname": "room",
   "label": "Habitación",
   "fieldtype": "Link",
   "options": "HS Room",
   "reqd": 1
  },
  {
   "fieldname": "kind",
   "label": "Tipo",
   "fieldtype": "Select",
   "options": "Damage\nLost Property\nLinen",
   "reqd": 1,
   "default": "Damage"
  },
  {
   "fieldname": "description",
   "label": "Descripción",
   "fieldtype": "Small Text",
   "reqd": 1
  },
  {
   "fieldname": "evidence",
   "label": "Evidencia",
   "fieldtype": "Attach"
  },
  {
   "fieldname": "item",
   "label": "Artículo",
   "fieldtype": "Data"
  },
  {
   "fieldname": "quantity",
   "label": "Cantidad",
   "fieldtype": "Float",
   "default": 0
  },
  {
   "fieldname": "status",
   "label": "Estado",
   "fieldtype": "Select",
   "options": "Open\nResolved",
   "reqd": 1,
   "default": "Open"
  },
  {
   "fieldname": "stock_entry",
   "label": "Movimiento de inventario",
   "fieldtype": "Data"
  },
  {
   "fieldname": "resolution",
   "label": "Resolución",
   "fieldtype": "Small Text"
  },
  {
   "fieldname": "resolved_by",
   "label": "Resuelto por",
   "fieldtype": "Link",
   "options": "User"
  },
  {
   "fieldname": "resolved_at",
   "label": "Resolución registrada",
   "fieldtype": "Datetime"
  }
 ],
 "field_order": [
